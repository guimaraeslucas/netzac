// Windows resource script: application icon (Explorer, taskbar, Alt-Tab,
// window title bar) plus the VERSIONINFO block shown in the file's
// Properties > Details dialog. Every @VALUE@ is injected by Meson from
// meson.build (see shell/netzac/meson.build), so the metadata has a single
// source of truth.
1 ICON "@ZACOS9_ICON_PATH@"

// NOTE: the version block must use the numeric ID 1 (not the "VS_VERSION_INFO"
// name), otherwise GetFileVersionInfo() cannot find it and Explorer shows no
// version details.
1 VERSIONINFO
  FILEVERSION @ZACOS9_VERSION_QUAD@
  PRODUCTVERSION @ZACOS9_VERSION_QUAD@
  FILEFLAGSMASK 0x3fL
  FILEFLAGS 0x0L
  FILEOS 0x40004L
  FILETYPE 0x1L
  FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "@ZACOS9_COMPANY@"
      VALUE "FileDescription", "@ZACOS9_PRODUCT_DESCRIPTION@"
      VALUE "FileVersion", "@ZACOS9_VERSION@"
      VALUE "InternalName", "zacos9-netzac"
      VALUE "LegalCopyright", "@ZACOS9_COPYRIGHT@"
      VALUE "OriginalFilename", "zacos9-netzac.exe"
      VALUE "ProductName", "@ZACOS9_PRODUCT_NAME@"
      VALUE "ProductVersion", "@ZACOS9_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
