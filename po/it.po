msgid "<p>Unknown built-in Navigator location.</p>"
msgstr "<p>Posizione interna di Navigator sconosciuta.</p>"

#: shell/netzac/netzacwindow.cpp
msgid "<p>Welcome aboard <b>Netzac Navigator 1.0</b> running on <b>ZacOS 9</b>.</p><p>Quick links to explore the classic &amp; text-friendly Web:</p><div class=\"cards\"><a class=\"card\" href=\"https://frogfind.com\"><strong>FrogFind!</strong><span>Classic search engine for retro browsers</span></a><a class=\"card\" href=\"https://wiby.me\"><strong>Wiby</strong><span>Search engine for classic web pages</span></a><a class=\"card\" href=\"http://68k.news\"><strong>68k.news</strong><span>Fast headlines formatted for classic Macs</span></a><a class=\"card\" href=\"https://theoldnet.com\"><strong>The Old Net</strong><span>Browse snapshots of the 1990s web</span></a></div><div class=\"credits-box\"><h2>Credits &amp; Community</h2><p>Netzac started as an initial idea by <b>Lucas Guimarães</b>. We hope to count on the full support of the <b>ZacOS 9</b> community for contributions, ideas, and pull requests at <a href=\"https://github.com/guimaraeslucas/netzac\">github.com/guimaraeslucas/netzac</a>.</p><p style=\"margin-bottom:0;\">Special thanks to <b>Adam Lawson (@chromasystemprofessional)</b> for creating this incredible ZacOS 9 project.</p></div>"
msgstr "<p>Benvenuto a bordo di <b>Netzac Navigator 1.0</b> su <b>ZacOS 9</b>.</p><p>Collegamenti rapidi per esplorare il Web classico e leggero:</p><div class=\"cards\"><a class=\"card\" href=\"https://frogfind.com\"><strong>FrogFind!</strong><span>Motore di ricerca classico per browser retrò</span></a><a class=\"card\" href=\"https://wiby.me\"><strong>Wiby</strong><span>Motore di ricerca per pagine Web classiche</span></a><a class=\"card\" href=\"http://68k.news\"><strong>68k.news</strong><span>Notizie veloci formattate per Mac classici</span></a><a class=\"card\" href=\"https://theoldnet.com\"><strong>The Old Net</strong><span>Esplora il Web degli anni ’90</span></a></div><div class=\"credits-box\"><h2>Crediti e Comunità</h2><p>Netzac è nato da un’idea iniziale di <b>Lucas Guimarães</b>. Contiamo sul supporto della comunità di <b>ZacOS 9</b> per contributi, idee e pull request su <a href=\"https://github.com/guimaraeslucas/netzac\">github.com/guimaraeslucas/netzac</a>.</p><p style=\"margin-bottom:0;\">Un ringraziamento speciale ad <b>Adam Lawson (@chromasystemprofessional)</b> per aver creato lo straordinario progetto ZacOS 9.</p></div>"

#: shell/netzac/netzacwindow.cpp
msgid "<ul class=\"shortcut-list\"><li><span><b>Collapse Toolbars</b></span><span>Click the ribbed grip on the left of any toolbar</span></li><li><span><b>Open Page</b></span><span><code>Ctrl+O</code></span></li><li><span><b>New / Close Tab</b></span><span><code>Ctrl+T</code> / <code>Ctrl+W</code></span></li><li><span><b>Find in Page / Find Again</b></span><span><code>Ctrl+F</code> or <code>F4</code> / <code>Ctrl+G</code></span></li><li><span><b>Zoom In / Out / Reset</b></span><span><code>Ctrl++</code> / <code>Ctrl+-</code> / <code>Ctrl+0</code></span></li><li><span><b>Add / Manage Bookmarks</b></span><span><code>Ctrl+D</code> / <code>Ctrl+B</code></span></li><li><span><b>Reload / Stop</b></span><span><code>Ctrl+R</code> or <code>F5</code> / <code>Esc</code></span></li><li><span><b>Full Screen</b></span><span><code>F11</code></span></li><li><span><b>Calm Mode</b></span><span><code>Ctrl+Shift+C</code></span></li><li><span><b>Page Source / Info</b></span><span><code>Ctrl+U</code> / <code>Ctrl+I</code></span></li></ul>"
msgstr "<ul class=\"shortcut-list\"><li><span><b>Comprimi barre degli strumenti</b></span><span>Fai clic sull’impugnatura zigrinata a sinistra di qualsiasi barra</span></li><li><span><b>Apri pagina</b></span><span><code>Ctrl+O</code></span></li><li><span><b>Nuova / Chiudi scheda</b></span><span><code>Ctrl+T</code> / <code>Ctrl+W</code></span></li><li><span><b>Trova / Trova successivo</b></span><span><code>Ctrl+F</code> o <code>F4</code> / <code>Ctrl+G</code></span></li><li><span><b>Ingrandisci / Riduci / Ripristina zoom</b></span><span><code>Ctrl++</code> / <code>Ctrl+-</code> / <code>Ctrl+0</code></span></li><li><span><b>Aggiungi / Gestisci segnalibri</b></span><span><code>Ctrl+D</code> / <code>Ctrl+B</code></span></li><li><span><b>Ricarica / Ferma</b></span><span><code>Ctrl+R</code> o <code>F5</code> / <code>Esc</code></span></li><li><span><b>Schermo intero</b></span><span><code>F11</code></span></li><li><span><b>Modalità Calma</b></span><span><code>Ctrl+Shift+C</code></span></li><li><span><b>Sorgente pagina / Info</b></span><span><code>Ctrl+U</code> / <code>Ctrl+I</code></span></li></ul>"

