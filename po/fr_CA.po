#: shell/netzac/netzacwindow.cpp
msgid "<div class=\"credits-box\" style=\"margin-top:0;\"><h2>Netzac Chat</h2><p style=\"margin-bottom:0;\">To configure this button to open your chat service, open <b>Edit &rsaquo; Preferences &rsaquo; Quick Links</b> and set the <b>Chat URL</b>.</p></div>"
msgstr "<div class=\"credits-box\" style=\"margin-top:0;\"><h2>Netzac Chat</h2><p style=\"margin-bottom:0;\">Pour configurer ce bouton afin d’ouvrir votre service de messagerie instantanée, ouvrez <b>Édition &rsaquo; Préférences &rsaquo; Liens rapides</b> et définissez l’<b>URL du chat</b>.</p></div>"

#: shell/netzac/netzacwindow.cpp
msgid "<div class=\"credits-box\" style=\"margin-top:0;\"><h2>Netzac Git</h2><p style=\"margin-bottom:0;\">To configure this button to open your Git forge (for example GitHub, GitLab or Gitea), open <b>Edit &rsaquo; Preferences &rsaquo; Quick Links</b> and set the <b>Git URL</b>.</p></div>"
msgstr "<div class=\"credits-box\" style=\"margin-top:0;\"><h2>Netzac Git</h2><p style=\"margin-bottom:0;\">Pour configurer ce bouton afin d’ouvrir votre forge Git (par exemple GitHub, GitLab ou Gitea), ouvrez <b>Édition &rsaquo; Préférences &rsaquo; Liens rapides</b> et définissez l’<b>URL Git</b>.</p></div>"

#: shell/netzac/netzacwindow.cpp
msgid "<div class=\"credits-box\" style=\"margin-top:0;\"><h2>Netzac Mail</h2><p style=\"margin-bottom:0;\">To configure this button to open your mail link (for example Gmail or webmail), open <b>Edit &rsaquo; Preferences &rsaquo; Quick Links</b> and set the <b>Mail URL</b>.</p></div>"
msgstr "<div class=\"credits-box\" style=\"margin-top:0;\"><h2>Netzac Courriel</h2><p style=\"margin-bottom:0;\">Pour configurer ce bouton afin d’ouvrir votre courriel (par exemple Gmail ou webmail), ouvrez <b>Édition &rsaquo; Préférences &rsaquo; Liens rapides</b> et définissez l’<b>URL de courriel</b>.</p></div>"

#: shell/netzac/netzacwindow.cpp
msgid "<p>Unknown built-in Navigator location.</p>"
msgstr "<p>Emplacement interne de Navigator inconnu.</p>"

#: shell/netzac/netzacwindow.cpp
msgid "<p>Welcome aboard <b>Netzac Navigator 1.0</b> running on <b>ZacOS 9</b>.</p><p>Quick links to explore the classic &amp; text-friendly Web:</p><div class=\"cards\"><a class=\"card\" href=\"https://frogfind.com\"><strong>FrogFind!</strong><span>Classic search engine for retro browsers</span></a><a class=\"card\" href=\"https://wiby.me\"><strong>Wiby</strong><span>Search engine for classic web pages</span></a><a class=\"card\" href=\"http://68k.news\"><strong>68k.news</strong><span>Fast headlines formatted for classic Macs</span></a><a class=\"card\" href=\"https://theoldnet.com\"><strong>The Old Net</strong><span>Browse snapshots of the 1990s web</span></a></div><div class=\"credits-box\"><h2>Credits &amp; Community</h2><p>Netzac started as an initial idea by <b>Lucas Guimarães</b>. We hope to count on the full support of the <b>ZacOS 9</b> community for contributions, ideas, and pull requests at <a href=\"https://github.com/guimaraeslucas/netzac\">github.com/guimaraeslucas/netzac</a>.</p><p style=\"margin-bottom:0;\">Special thanks to <b>Adam Lawson (@chromasystemprofessional)</b> for creating this incredible ZacOS 9 project.</p></div>"
msgstr "<p>Bienvenue à bord de <b>Netzac Navigator 1.0</b> sur <b>ZacOS 9</b>.</p><p>Liens rapides pour explorer le Web classique et léger :</p><div class=\"cards\"><a class=\"card\" href=\"https://frogfind.com\"><strong>FrogFind!</strong><span>Moteur de recherche classique pour navigateurs rétro</span></a><a class=\"card\" href=\"https://wiby.me\"><strong>Wiby</strong><span>Moteur de recherche pour pages Web classiques</span></a><a class=\"card\" href=\"http://68k.news\"><strong>68k.news</strong><span>Actualités rapides formatées pour Mac classiques</span></a><a class=\"card\" href=\"https://theoldnet.com\"><strong>The Old Net</strong><span>Parcourir les archives du Web des années 1990</span></a></div><div class=\"credits-box\"><h2>Crédits et Communauté</h2><p>Netzac est né d’une idée initiale de <b>Lucas Guimarães</b>. Nous comptons sur le soutien de la communauté <b>ZacOS 9</b> pour vos contributions, idées et pull requests sur <a href=\"https://github.com/guimaraeslucas/netzac\">github.com/guimaraeslucas/netzac</a>.</p><p style=\"margin-bottom:0;\">Remerciements particuliers à <b>Adam Lawson (@chromasystemprofessional)</b> pour la création de l’incroyable projet ZacOS 9.</p></div>"

#: shell/netzac/netzacwindow.cpp
msgid "<ul class=\"shortcut-list\"><li><span><b>Collapse Toolbars</b></span><span>Click the ribbed grip on the left of any toolbar</span></li><li><span><b>Open Page</b></span><span><code>Ctrl+O</code></span></li><li><span><b>New / Close Tab</b></span><span><code>Ctrl+T</code> / <code>Ctrl+W</code></span></li><li><span><b>Find in Page / Find Again</b></span><span><code>Ctrl+F</code> or <code>F4</code> / <code>Ctrl+G</code></span></li><li><span><b>Zoom In / Out / Reset</b></span><span><code>Ctrl++</code> / <code>Ctrl+-</code> / <code>Ctrl+0</code></span></li><li><span><b>Add / Manage Bookmarks</b></span><span><code>Ctrl+D</code> / <code>Ctrl+B</code></span></li><li><span><b>Reload / Stop</b></span><span><code>Ctrl+R</code> or <code>F5</code> / <code>Esc</code></span></li><li><span><b>Full Screen</b></span><span><code>F11</code></span></li><li><span><b>Calm Mode</b></span><span><code>Ctrl+Shift+C</code></span></li><li><span><b>Page Source / Info</b></span><span><code>Ctrl+U</code> / <code>Ctrl+I</code></span></li></ul>"
msgstr "<ul class=\"shortcut-list\"><li><span><b>Réduire les barres d’outils</b></span><span>Cliquez sur la poignée striée à gauche d’une barre</span></li><li><span><b>Ouvrir une page</b></span><span><code>Ctrl+O</code></span></li><li><span><b>Nouvel onglet / Fermer l’onglet</b></span><span><code>Ctrl+T</code> / <code>Ctrl+W</code></span></li><li><span><b>Rechercher / Suivant</b></span><span><code>Ctrl+F</code> ou <code>F4</code> / <code>Ctrl+G</code></span></li><li><span><b>Zoom avant / arrière / réinitialiser</b></span><span><code>Ctrl++</code> / <code>Ctrl+-</code> / <code>Ctrl+0</code></span></li><li><span><b>Ajouter / Gérer les signets</b></span><span><code>Ctrl+D</code> / <code>Ctrl+B</code></span></li><li><span><b>Recharger / Arrêter</b></span><span><code>Ctrl+R</code> ou <code>F5</code> / <code>Esc</code></span></li><li><span><b>Plein écran</b></span><span><code>F11</code></span></li><li><span><b>Mode Calme</b></span><span><code>Ctrl+Shift+C</code></span></li><li><span><b>Code source / Infos sur la page</b></span><span><code>Ctrl+U</code> / <code>Ctrl+I</code></span></li></ul>"

