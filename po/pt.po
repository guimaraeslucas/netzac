#: shell/netzac/netzacwindow.cpp
msgid "<div class=\"credits-box\" style=\"margin-top:0;\"><h2>Netzac Chat</h2><p style=\"margin-bottom:0;\">To configure this button to open your chat service, open <b>Edit &rsaquo; Preferences &rsaquo; Quick Links</b> and set the <b>Chat URL</b>.</p></div>"
msgstr "<div class=\"credits-box\" style=\"margin-top:0;\"><h2>Netzac Chat</h2><p style=\"margin-bottom:0;\">Para configurar este botão para abrir seu serviço de chat, abra <b>Editar &rsaquo; Preferências &rsaquo; Links Rápidos</b> e defina a <b>URL do Chat</b>.</p></div>"

#: shell/netzac/netzacwindow.cpp
msgid "<div class=\"credits-box\" style=\"margin-top:0;\"><h2>Netzac Git</h2><p style=\"margin-bottom:0;\">To configure this button to open your Git forge (for example GitHub, GitLab or Gitea), open <b>Edit &rsaquo; Preferences &rsaquo; Quick Links</b> and set the <b>Git URL</b>.</p></div>"
msgstr "<div class=\"credits-box\" style=\"margin-top:0;\"><h2>Netzac Git</h2><p style=\"margin-bottom:0;\">Para configurar este botão para abrir seu serviço Git (por exemplo GitHub, GitLab ou Gitea), abra <b>Editar &rsaquo; Preferências &rsaquo; Links Rápidos</b> e defina a <b>URL do Git</b>.</p></div>"

#: shell/netzac/netzacwindow.cpp
msgid "<div class=\"credits-box\" style=\"margin-top:0;\"><h2>Netzac Mail</h2><p style=\"margin-bottom:0;\">To configure this button to open your mail link (for example Gmail or webmail), open <b>Edit &rsaquo; Preferences &rsaquo; Quick Links</b> and set the <b>Mail URL</b>.</p></div>"
msgstr "<div class=\"credits-box\" style=\"margin-top:0;\"><h2>Netzac Mail</h2><p style=\"margin-bottom:0;\">Para configurar este botão para abrir seu e-mail (por exemplo Gmail ou webmail), abra <b>Editar &rsaquo; Preferências &rsaquo; Links Rápidos</b> e defina a <b>URL do E-mail</b>.</p></div>"

#: shell/netzac/netzacwindow.cpp
msgid "<p>Unknown built-in Navigator location.</p>"
msgstr "<p>Endereço interno do Navigator desconhecido.</p>"

#: shell/netzac/netzacwindow.cpp
msgid "<p>Welcome aboard <b>Netzac Navigator 1.0</b> running on <b>ZacOS 9</b>.</p><p>Quick links to explore the classic &amp; text-friendly Web:</p><div class=\"cards\"><a class=\"card\" href=\"https://frogfind.com\"><strong>FrogFind!</strong><span>Classic search engine for retro browsers</span></a><a class=\"card\" href=\"https://wiby.me\"><strong>Wiby</strong><span>Search engine for classic web pages</span></a><a class=\"card\" href=\"http://68k.news\"><strong>68k.news</strong><span>Fast headlines formatted for classic Macs</span></a><a class=\"card\" href=\"https://theoldnet.com\"><strong>The Old Net</strong><span>Browse snapshots of the 1990s web</span></a></div><div class=\"credits-box\"><h2>Credits &amp; Community</h2><p>Netzac started as an initial idea by <b>Lucas Guimarães</b>. We hope to count on the full support of the <b>ZacOS 9</b> community for contributions, ideas, and pull requests at <a href=\"https://github.com/guimaraeslucas/netzac\">github.com/guimaraeslucas/netzac</a>.</p><p style=\"margin-bottom:0;\">Special thanks to <b>Adam Lawson (@chromasystemprofessional)</b> for creating this incredible ZacOS 9 project.</p></div>"
msgstr "<p>Bem-vindo a bordo do <b>Netzac Navigator 1.0</b> rodando no <b>ZacOS 9</b>.</p><p>Links rápidos para explorar a Web clássica e leve:</p><div class=\"cards\"><a class=\"card\" href=\"https://frogfind.com\"><strong>FrogFind!</strong><span>Buscador clássico para navegadores retrô</span></a><a class=\"card\" href=\"https://wiby.me\"><strong>Wiby</strong><span>Buscador para páginas clássicas da Web</span></a><a class=\"card\" href=\"http://68k.news\"><strong>68k.news</strong><span>Manchetes rápidas formatadas para Macs clássicos</span></a><a class=\"card\" href=\"https://theoldnet.com\"><strong>The Old Net</strong><span>Navegue por registros da Web dos anos 1990</span></a></div><div class=\"credits-box\"><h2>Créditos e Comunidade</h2><p>O Netzac teve como ideia inicial <b>Lucas Guimarães</b>. Esperamos contar com todo o apoio da comunidade do <b>ZacOS 9</b> para contribuições, ideias e pull requests em <a href=\"https://github.com/guimaraeslucas/netzac\">github.com/guimaraeslucas/netzac</a>.</p><p style=\"margin-bottom:0;\">Agradecimento especial a <b>Adam Lawson (@chromasystemprofessional)</b> por criar esse incrível projeto que é o ZacOS 9.</p></div>"

#: shell/netzac/netzacwindow.cpp
msgid "<ul class=\"shortcut-list\"><li><span><b>Collapse Toolbars</b></span><span>Click the ribbed grip on the left of any toolbar</span></li><li><span><b>Open Page</b></span><span><code>Ctrl+O</code></span></li><li><span><b>New / Close Tab</b></span><span><code>Ctrl+T</code> / <code>Ctrl+W</code></span></li><li><span><b>Find in Page / Find Again</b></span><span><code>Ctrl+F</code> or <code>F4</code> / <code>Ctrl+G</code></span></li><li><span><b>Zoom In / Out / Reset</b></span><span><code>Ctrl++</code> / <code>Ctrl+-</code> / <code>Ctrl+0</code></span></li><li><span><b>Add / Manage Bookmarks</b></span><span><code>Ctrl+D</code> / <code>Ctrl+B</code></span></li><li><span><b>Reload / Stop</b></span><span><code>Ctrl+R</code> or <code>F5</code> / <code>Esc</code></span></li><li><span><b>Full Screen</b></span><span><code>F11</code></span></li><li><span><b>Calm Mode</b></span><span><code>Ctrl+Shift+C</code></span></li><li><span><b>Page Source / Info</b></span><span><code>Ctrl+U</code> / <code>Ctrl+I</code></span></li></ul>"
msgstr "<ul class=\"shortcut-list\"><li><span><b>Recolher Barras de Ferramentas</b></span><span>Clique na alça estriada à esquerda de qualquer barra</span></li><li><span><b>Abrir Página</b></span><span><code>Ctrl+O</code></span></li><li><span><b>Nova / Fechar Aba</b></span><span><code>Ctrl+T</code> / <code>Ctrl+W</code></span></li><li><span><b>Localizar / Localizar Novamente</b></span><span><code>Ctrl+F</code> ou <code>F4</code> / <code>Ctrl+G</code></span></li><li><span><b>Aumentar / Diminuir / Redefinir Zoom</b></span><span><code>Ctrl++</code> / <code>Ctrl+-</code> / <code>Ctrl+0</code></span></li><li><span><b>Adicionar / Gerenciar Favoritos</b></span><span><code>Ctrl+D</code> / <code>Ctrl+B</code></span></li><li><span><b>Recarregar / Parar</b></span><span><code>Ctrl+R</code> ou <code>F5</code> / <code>Esc</code></span></li><li><span><b>Tela Cheia</b></span><span><code>F11</code></span></li><li><span><b>Modo Calmo</b></span><span><code>Ctrl+Shift+C</code></span></li><li><span><b>Código-Fonte / Informações da Página</b></span><span><code>Ctrl+U</code> / <code>Ctrl+I</code></span></li></ul>"

