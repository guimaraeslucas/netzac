#: shell/netzac/netzacwindow.cpp
msgid "<div class=\"credits-box\" style=\"margin-top:0;\"><h2>Netzac Chat</h2><p style=\"margin-bottom:0;\">To configure this button to open your chat service, open <b>Edit &rsaquo; Preferences &rsaquo; Quick Links</b> and set the <b>Chat URL</b>.</p></div>"
msgstr "<div class=\"credits-box\" style=\"margin-top:0;\"><h2>Netzac Chat</h2><p style=\"margin-bottom:0;\">Para configurar este botón para abrir su servicio de chat, abra <b>Editar &rsaquo; Preferencias &rsaquo; Enlaces Rápidos</b> y establezca la <b>URL de Chat</b>.</p></div>"

#: shell/netzac/netzacwindow.cpp
msgid "<div class=\"credits-box\" style=\"margin-top:0;\"><h2>Netzac Git</h2><p style=\"margin-bottom:0;\">To configure this button to open your Git forge (for example GitHub, GitLab or Gitea), open <b>Edit &rsaquo; Preferences &rsaquo; Quick Links</b> and set the <b>Git URL</b>.</p></div>"
msgstr "<div class=\"credits-box\" style=\"margin-top:0;\"><h2>Netzac Git</h2><p style=\"margin-bottom:0;\">Para configurar este botón para abrir su servicio Git (por ejemplo GitHub, GitLab o Gitea), abra <b>Editar &rsaquo; Preferencias &rsaquo; Enlaces Rápidos</b> y establezca la <b>URL de Git</b>.</p></div>"

#: shell/netzac/netzacwindow.cpp
msgid "<div class=\"credits-box\" style=\"margin-top:0;\"><h2>Netzac Mail</h2><p style=\"margin-bottom:0;\">To configure this button to open your mail link (for example Gmail or webmail), open <b>Edit &rsaquo; Preferences &rsaquo; Quick Links</b> and set the <b>Mail URL</b>.</p></div>"
msgstr "<div class=\"credits-box\" style=\"margin-top:0;\"><h2>Netzac Correo</h2><p style=\"margin-bottom:0;\">Para configurar este botón para abrir su correo (por ejemplo Gmail o webmail), abra <b>Editar &rsaquo; Preferencias &rsaquo; Enlaces Rápidos</b> y establezca la <b>URL de Correo</b>.</p></div>"

#: shell/netzac/netzacwindow.cpp
msgid "<p>Unknown built-in Navigator location.</p>"
msgstr "<p>Ubicación interna de Navigator desconocida.</p>"

#: shell/netzac/netzacwindow.cpp
msgid "<p>Welcome aboard <b>Netzac Navigator 1.0</b> running on <b>ZacOS 9</b>.</p><p>Quick links to explore the classic &amp; text-friendly Web:</p><div class=\"cards\"><a class=\"card\" href=\"https://frogfind.com\"><strong>FrogFind!</strong><span>Classic search engine for retro browsers</span></a><a class=\"card\" href=\"https://wiby.me\"><strong>Wiby</strong><span>Search engine for classic web pages</span></a><a class=\"card\" href=\"http://68k.news\"><strong>68k.news</strong><span>Fast headlines formatted for classic Macs</span></a><a class=\"card\" href=\"https://theoldnet.com\"><strong>The Old Net</strong><span>Browse snapshots of the 1990s web</span></a></div><div class=\"credits-box\"><h2>Credits &amp; Community</h2><p>Netzac started as an initial idea by <b>Lucas Guimarães</b>. We hope to count on the full support of the <b>ZacOS 9</b> community for contributions, ideas, and pull requests at <a href=\"https://github.com/guimaraeslucas/netzac\">github.com/guimaraeslucas/netzac</a>.</p><p style=\"margin-bottom:0;\">Special thanks to <b>Adam Lawson (@chromasystemprofessional)</b> for creating this incredible ZacOS 9 project.</p></div>"
msgstr "<p>Bienvenido a bordo de <b>Netzac Navigator 1.0</b> ejecutándose en <b>ZacOS 9</b>.</p><p>Enlaces rápidos para explorar la Web clásica y ligera:</p><div class=\"cards\"><a class=\"card\" href=\"https://frogfind.com\"><strong>FrogFind!</strong><span>Buscador clásico para navegadores retro</span></a><a class=\"card\" href=\"https://wiby.me\"><strong>Wiby</strong><span>Buscador para páginas web clásicas</span></a><a class=\"card\" href=\"http://68k.news\"><strong>68k.news</strong><span>Titulares rápidos adaptados para Macs clásicos</span></a><a class=\"card\" href=\"https://theoldnet.com\"><strong>The Old Net</strong><span>Explora archivos de la web de los años 90</span></a></div><div class=\"credits-box\"><h2>Créditos y Comunidad</h2><p>Netzac nació como una idea inicial de <b>Lucas Guimarães</b>. Esperamos contar con todo el apoyo de la comunidad de <b>ZacOS 9</b> para contribuciones, ideas y pull requests en <a href=\"https://github.com/guimaraeslucas/netzac\">github.com/guimaraeslucas/netzac</a>.</p><p style=\"margin-bottom:0;\">Agradecimiento especial a <b>Adam Lawson (@chromasystemprofessional)</b> por crear este increíble proyecto ZacOS 9.</p></div>"

#: shell/netzac/netzacwindow.cpp
msgid "<ul class=\"shortcut-list\"><li><span><b>Collapse Toolbars</b></span><span>Click the ribbed grip on the left of any toolbar</span></li><li><span><b>Open Page</b></span><span><code>Ctrl+O</code></span></li><li><span><b>New / Close Tab</b></span><span><code>Ctrl+T</code> / <code>Ctrl+W</code></span></li><li><span><b>Find in Page / Find Again</b></span><span><code>Ctrl+F</code> or <code>F4</code> / <code>Ctrl+G</code></span></li><li><span><b>Zoom In / Out / Reset</b></span><span><code>Ctrl++</code> / <code>Ctrl+-</code> / <code>Ctrl+0</code></span></li><li><span><b>Add / Manage Bookmarks</b></span><span><code>Ctrl+D</code> / <code>Ctrl+B</code></span></li><li><span><b>Reload / Stop</b></span><span><code>Ctrl+R</code> or <code>F5</code> / <code>Esc</code></span></li><li><span><b>Full Screen</b></span><span><code>F11</code></span></li><li><span><b>Calm Mode</b></span><span><code>Ctrl+Shift+C</code></span></li><li><span><b>Page Source / Info</b></span><span><code>Ctrl+U</code> / <code>Ctrl+I</code></span></li></ul>"
msgstr "<ul class=\"shortcut-list\"><li><span><b>Contraer barras de herramientas</b></span><span>Haz clic en el asa estriada a la izquierda de cualquier barra</span></li><li><span><b>Abrir página</b></span><span><code>Ctrl+O</code></span></li><li><span><b>Nueva / Cerrar pestaña</b></span><span><code>Ctrl+T</code> / <code>Ctrl+W</code></span></li><li><span><b>Buscar / Buscar de nuevo</b></span><span><code>Ctrl+F</code> o <code>F4</code> / <code>Ctrl+G</code></span></li><li><span><b>Acercar / Alejar / Restablecer zoom</b></span><span><code>Ctrl++</code> / <code>Ctrl+-</code> / <code>Ctrl+0</code></span></li><li><span><b>Añadir / Gestionar marcadores</b></span><span><code>Ctrl+D</code> / <code>Ctrl+B</code></span></li><li><span><b>Recargar / Detener</b></span><span><code>Ctrl+R</code> o <code>F5</code> / <code>Esc</code></span></li><li><span><b>Pantalla completa</b></span><span><code>F11</code></span></li><li><span><b>Modo Calma</b></span><span><code>Ctrl+Shift+C</code></span></li><li><span><b>Código fuente / Info de página</b></span><span><code>Ctrl+U</code> / <code>Ctrl+I</code></span></li></ul>"

