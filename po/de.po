#: shell/netzac/netzacwindow.cpp
msgid "<div class=\"credits-box\" style=\"margin-top:0;\"><h2>Netzac Chat</h2><p style=\"margin-bottom:0;\">To configure this button to open your chat service, open <b>Edit &rsaquo; Preferences &rsaquo; Quick Links</b> and set the <b>Chat URL</b>.</p></div>"
msgstr "<div class=\"credits-box\" style=\"margin-top:0;\"><h2>Netzac Chat</h2><p style=\"margin-bottom:0;\">Um diese Schaltfläche für Ihren Chat-Dienst einzurichten, öffnen Sie <b>Bearbeiten &rsaquo; Einstellungen &rsaquo; Schnelllinks</b> und legen Sie die <b>Chat-URL</b> fest.</p></div>"

#: shell/netzac/netzacwindow.cpp
msgid "<div class=\"credits-box\" style=\"margin-top:0;\"><h2>Netzac Git</h2><p style=\"margin-bottom:0;\">To configure this button to open your Git forge (for example GitHub, GitLab or Gitea), open <b>Edit &rsaquo; Preferences &rsaquo; Quick Links</b> and set the <b>Git URL</b>.</p></div>"
msgstr "<div class=\"credits-box\" style=\"margin-top:0;\"><h2>Netzac Git</h2><p style=\"margin-bottom:0;\">Um diese Schaltfläche für Ihren Git-Dienst (z. B. GitHub, GitLab oder Gitea) einzurichten, öffnen Sie <b>Bearbeiten &rsaquo; Einstellungen &rsaquo; Schnelllinks</b> und legen Sie die <b>Git-URL</b> fest.</p></div>"

#: shell/netzac/netzacwindow.cpp
msgid "<div class=\"credits-box\" style=\"margin-top:0;\"><h2>Netzac Mail</h2><p style=\"margin-bottom:0;\">To configure this button to open your mail link (for example Gmail or webmail), open <b>Edit &rsaquo; Preferences &rsaquo; Quick Links</b> and set the <b>Mail URL</b>.</p></div>"
msgstr "<div class=\"credits-box\" style=\"margin-top:0;\"><h2>Netzac Mail</h2><p style=\"margin-bottom:0;\">Um diese Schaltfläche für Ihren E-Mail-Dienst (z. B. Gmail oder Webmail) einzurichten, öffnen Sie <b>Bearbeiten &rsaquo; Einstellungen &rsaquo; Schnelllinks</b> und legen Sie die <b>E-Mail-URL</b> fest.</p></div>"

#: shell/netzac/netzacwindow.cpp
msgid "<p>Unknown built-in Navigator location.</p>"
msgstr "<p>Unbekannte interne Navigator-Adresse.</p>"

#: shell/netzac/netzacwindow.cpp
msgid "<p>Welcome aboard <b>Netzac Navigator 1.0</b> running on <b>ZacOS 9</b>.</p><p>Quick links to explore the classic &amp; text-friendly Web:</p><div class=\"cards\"><a class=\"card\" href=\"https://frogfind.com\"><strong>FrogFind!</strong><span>Classic search engine for retro browsers</span></a><a class=\"card\" href=\"https://wiby.me\"><strong>Wiby</strong><span>Search engine for classic web pages</span></a><a class=\"card\" href=\"http://68k.news\"><strong>68k.news</strong><span>Fast headlines formatted for classic Macs</span></a><a class=\"card\" href=\"https://theoldnet.com\"><strong>The Old Net</strong><span>Browse snapshots of the 1990s web</span></a></div><div class=\"credits-box\"><h2>Credits &amp; Community</h2><p>Netzac started as an initial idea by <b>Lucas Guimarães</b>. We hope to count on the full support of the <b>ZacOS 9</b> community for contributions, ideas, and pull requests at <a href=\"https://github.com/guimaraeslucas/netzac\">github.com/guimaraeslucas/netzac</a>.</p><p style=\"margin-bottom:0;\">Special thanks to <b>Adam Lawson (@chromasystemprofessional)</b> for creating this incredible ZacOS 9 project.</p></div>"
msgstr "<p>Willkommen an Bord von <b>Netzac Navigator 1.0</b> unter <b>ZacOS 9</b>.</p><p>Schnelllinks zum Entdecken des klassischen &amp; textfreundlichen Webs:</p><div class=\"cards\"><a class=\"card\" href=\"https://frogfind.com\"><strong>FrogFind!</strong><span>Klassische Suchmaschine für Retro-Browser</span></a><a class=\"card\" href=\"https://wiby.me\"><strong>Wiby</strong><span>Suchmaschine für klassische Webseiten</span></a><a class=\"card\" href=\"http://68k.news\"><strong>68k.news</strong><span>Schnelle Schlagzeilen für klassische Macs</span></a><a class=\"card\" href=\"https://theoldnet.com\"><strong>The Old Net</strong><span>Momentaufnahmen des Webs der 1990er Jahre durchsuchen</span></a></div><div class=\"credits-box\"><h2>Danksagung &amp; Community</h2><p>Netzac begann als Idee von <b>Lucas Guimarães</b>. Wir freuen uns auf die Unterstützung der <b>ZacOS 9</b>-Community durch Beiträge, Ideen und Pull Requests unter <a href=\"https://github.com/guimaraeslucas/netzac\">github.com/guimaraeslucas/netzac</a>.</p><p style=\"margin-bottom:0;\">Besonderer Dank gilt <b>Adam Lawson (@chromasystemprofessional)</b> für die Erschaffung dieses großartigen ZacOS 9-Projekts.</p></div>"

#: shell/netzac/netzacwindow.cpp
msgid "<ul class=\"shortcut-list\"><li><span><b>Collapse Toolbars</b></span><span>Click the ribbed grip on the left of any toolbar</span></li><li><span><b>Open Page</b></span><span><code>Ctrl+O</code></span></li><li><span><b>New / Close Tab</b></span><span><code>Ctrl+T</code> / <code>Ctrl+W</code></span></li><li><span><b>Find in Page / Find Again</b></span><span><code>Ctrl+F</code> or <code>F4</code> / <code>Ctrl+G</code></span></li><li><span><b>Zoom In / Out / Reset</b></span><span><code>Ctrl++</code> / <code>Ctrl+-</code> / <code>Ctrl+0</code></span></li><li><span><b>Add / Manage Bookmarks</b></span><span><code>Ctrl+D</code> / <code>Ctrl+B</code></span></li><li><span><b>Reload / Stop</b></span><span><code>Ctrl+R</code> or <code>F5</code> / <code>Esc</code></span></li><li><span><b>Full Screen</b></span><span><code>F11</code></span></li><li><span><b>Calm Mode</b></span><span><code>Ctrl+Shift+C</code></span></li><li><span><b>Page Source / Info</b></span><span><code>Ctrl+U</code> / <code>Ctrl+I</code></span></li></ul>"
msgstr "<ul class=\"shortcut-list\"><li><span><b>Symbolleisten einklappen</b></span><span>Auf den geriffelten Griff links an einer Symbolleiste klicken</span></li><li><span><b>Seite öffnen</b></span><span><code>Ctrl+O</code></span></li><li><span><b>Neuer Tab / Tab schließen</b></span><span><code>Ctrl+T</code> / <code>Ctrl+W</code></span></li><li><span><b>Auf Seite suchen / Weitersuchen</b></span><span><code>Ctrl+F</code> oder <code>F4</code> / <code>Ctrl+G</code></span></li><li><span><b>Vergrößern / Verkleinern / Zurücksetzen</b></span><span><code>Ctrl++</code> / <code>Ctrl+-</code> / <code>Ctrl+0</code></span></li><li><span><b>Lesezeichen hinzufügen / verwalten</b></span><span><code>Ctrl+D</code> / <code>Ctrl+B</code></span></li><li><span><b>Neu laden / Stopp</b></span><span><code>Ctrl+R</code> oder <code>F5</code> / <code>Esc</code></span></li><li><span><b>Vollbild</b></span><span><code>F11</code></span></li><li><span><b>Ruhemodus</b></span><span><code>Ctrl+Shift+C</code></span></li><li><span><b>Seitenquelltext / Seiteninformationen</b></span><span><code>Ctrl+U</code> / <code>Ctrl+I</code></span></li></ul>"

